{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-scan-gate.py\"",
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "SkillSpector: checking skill install..."
          }
        ]
      }
    ]
  }
}
